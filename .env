# Public FastAPI URL. Lovable reads this file at preview/publish time.
# Local `npm run dev` uses .env.local when that file exists.
# Secrets (Trigger, Exa, backend internal) do NOT belong here —
# they go in .env.local, Render, and the Trigger.dev dashboard.
VITE_API_BASE_URL=https://hakiscribe-backend.onrender.com
