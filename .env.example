# Copy this file to .env.local for local `npm run dev` + `npx trigger.dev dev`.
# Do NOT put secrets in the committed .env — Lovable publishes that file.
# Committed .env should only contain:
#   VITE_API_BASE_URL=https://hakiscribe-backend.onrender.com

# Local frontend override. Published Lovable app uses the committed .env.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Enables the cookie-backed Supabase production sign-in UI. The backend must
# also set HAKISCRIBE_PRODUCTION_AUTH=true and allow this frontend origin.
VITE_PRODUCTION_AUTH=false

# Server-only. Used by /research (TanStack server function) for Exa citation search.
# Local: set in .env.local. Lovable: More → Cloud → Secrets (not a VITE_ name).
# Prefer the same key as hakiscribe-backend/.env.local EXA_API_KEY.
EXA_API_KEY=

# Trigger.dev — local worker + SDK. Use a Development API key from the dashboard.
# TRIGGER_PROJECT_REF is also hardcoded in trigger.config.ts.
TRIGGER_PROJECT_REF=proj_hobqixzcvyknoigffkjq
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# Trigger.dev tasks call the public FastAPI /internal endpoints.
# Same pair must be set in the Trigger.dev dashboard and on Render.
# Not used by the Lovable browser bundle.
BACKEND_INTERNAL_URL=https://hakiscribe-backend.onrender.com
BACKEND_INTERNAL_SECRET=
