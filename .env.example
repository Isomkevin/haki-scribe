# Public URL of the HakiScribe FastAPI service.
# Local: copy to .env.local so it overrides the committed production .env
#   uvicorn app.main:app --reload --port 8000  ->  http://localhost:8000
# Published Lovable app uses the committed .env (Render).
VITE_API_BASE_URL=http://localhost:8000

# Server-only. Used by /research (TanStack server function) for Exa citation search.
# Prefer the same key as hakiscribe-backend/.env.local EXA_API_KEY.
EXA_API_KEY=

# Trigger.dev — local worker + SDK. Use a Development API key from the dashboard.
TRIGGER_PROJECT_REF=proj_hobqixzcvyknoigffkjq
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev