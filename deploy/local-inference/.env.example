# Copy to .env next to docker-compose.yml.

# --- faster-whisper ---------------------------------------------------------
LOCAL_WHISPER_PORT=8001
# large-v3 is the accuracy target for EN/SW court audio but is slow on CPU.
# For CPU-only boxes, Systran/faster-whisper-small or -medium are practical.
LOCAL_WHISPER_MODEL=Systran/faster-whisper-large-v3
WHISPER_DEVICE=cpu            # cuda on the gpu profile
WHISPER_COMPUTE_TYPE=int8     # float16 on GPU
# Auto-detection may only pick these (a Kiswahili clip was detected as Javanese
# without this). Empty = any Whisper language.
WHISPER_ALLOWED_LANGUAGES=en,sw
# Built-in court vocabulary prompt, applied only when the caller explicitly sets
# one of these languages. Measured: it raised Kiswahili WER (0.66 -> 0.77) and
# was sometimes echoed as transcript text, so it is English-only by default.
WHISPER_LEGAL_PROMPT_LANGS=en
# Override the prompt text, or set empty to disable it entirely.
# WHISPER_LEGAL_PROMPT=
# WHISPER_VAD_MIN_SILENCE_MS=500
# WHISPER_VAD_SPEECH_PAD_MS=400

# --- diarization (optional, ~2 GB extra image size) -------------------------
# Build with:  WITH_DIARIZATION=1 docker compose --profile cpu build faster-whisper
WITH_DIARIZATION=0
DIARIZATION_ENABLED=0
# Must have accepted the pyannote/speaker-diarization-3.1 terms on Hugging Face.
HF_TOKEN=

# --- Ollama -----------------------------------------------------------------
OLLAMA_PORT=11434

# --- GPU profile (vLLM) -----------------------------------------------------
VLLM_PORT=8002
VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
HUGGING_FACE_HUB_TOKEN=
