ASR_PROVIDER=openrouter     # openrouter | openai | groq | intron
ASR_MODEL=openai/whisper-large-v3
GROQ_API_KEY=
OPENAI_API_KEY=
OMI_SHARED_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Action detection + drafting (Granola-style action tray)
# Routed through OpenRouter, pointed at an OpenAI model by default —
# exercises both sponsors genuinely rather than picking one arbitrarily.
OPENROUTER_API_KEY=
DETECTION_MODEL=openai/gpt-4o
DRAFTING_MODEL=openai/gpt-4o

# Ambiguous AI — real Docs/Calendar/CRM/Chat integration for the action
# tray. Leave blank to fall back to local-only generation everywhere.
AMBIGUOUS_API_KEY=
AMBIGUOUS_NOTIFY_CHANNEL=general

# Exa — optional company/counterparty enrichment on detected actions.
# Leave blank to skip enrichment entirely.
EXA_API_KEY=

# Trigger.dev — runs /detect and /generate as durable background tasks.
# Leave blank to fall back to running the same logic directly in-process.
TRIGGER_SECRET_KEY=
BACKEND_INTERNAL_URL=https://your-public-backend-url
BACKEND_INTERNAL_SECRET=

# Free-form "Ask anything about this session" composer + research
# synthesis. Any OpenRouter model id (Claude, GPT, Gemini, Llama…).
ASK_MODEL=openai/gpt-4o
