ASR_PROVIDER=openrouter     # openrouter | openai | groq | intron
ASR_MODEL=openai/whisper-large-v3
GROQ_API_KEY=
OPENAI_API_KEY=
OMI_SHARED_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Action detection + drafting (Granola-style action tray)
# Routed through OpenRouter, pointed at an OpenAI model by default —
# exercises both sponsors genuinely rather than picking one arbitrarily.
OPENROUTER_API_KEY=
DETECTION_MODEL=openai/gpt-4o
DRAFTING_MODEL=openai/gpt-4o

# Ambiguous AI — real Docs/Calendar/CRM/Chat integration for the action
# tray. Leave blank to fall back to local-only generation everywhere.
AMBIGUOUS_API_KEY=
# Channel UUID from Ambiguous Chat (not the word "general").
AMBIGUOUS_NOTIFY_CHANNEL=
# Optional. Leave blank to use the workspace default calendar.
AMBIGUOUS_CALENDAR_ID=

# Exa — citation crawl, web search, company lookup, and news monitors.
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Public HTTPS URL Exa POSTs to (defaults to BACKEND_INTERNAL_URL/webhooks/exa).
# localhost is rejected — Exa's cloud cannot reach it.
EXA_MONITOR_WEBHOOK_URL=https://hakiscribe-backend.onrender.com/webhooks/exa

# Trigger.dev — runs /detect and /generate as durable background tasks.
# Local: Development key (tr_dev_...). Render: prod key (tr_prod_...).
# Leave blank to fall back to running the same logic directly in-process.
TRIGGER_SECRET_KEY=
# Public URL Trigger.dev's cloud can reach (not localhost).
BACKEND_INTERNAL_URL=https://hakiscribe-backend.onrender.com
# Must match Render AND the Trigger.dev dashboard Environment Variables.
BACKEND_INTERNAL_SECRET=

# Free-form "Ask anything about this session" composer + research
# synthesis. Any OpenRouter model id (Claude, GPT, Gemini, Llama…).
ASK_MODEL=openai/gpt-4o

# Durable storage. Any Postgres connection string (Supabase, Neon, Render
# Postgres). Unset = in-memory + local JSON file, which clears on restart.
DATABASE_URL=

# Optional S3 archive of every drafted document.
S3_BUCKET=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Connector sign-in (OAuth). Each app's redirect/callback URL must be
# {BACKEND_INTERNAL_URL}/integrations/oauth/{provider}/callback
#   google_drive, google_calendar, dropbox, onedrive
# ---------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Enable the Drive API and Calendar API on the same project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional. Defaults to the signed-in user's primary calendar.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Africa/Nairobi

# Dropbox App Console → your app → Settings. Scopes: files.content.write,
# files.content.read, account_info.read. Redirect URI as above.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Azure Portal → App registrations → your app. Delegated permissions:
# Files.ReadWrite, User.Read, offline_access. Redirect URI as above.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Overrides the base used to build OAuth redirect URLs (defaults to
# BACKEND_INTERNAL_URL). Use http://127.0.0.1:8000 when testing locally.
OAUTH_REDIRECT_BASE_URL=

# ---------------------------------------------------------------------------
# Gemini via Vertex AI (uses the same Google OAuth client as Drive/Calendar).
# Add the callback /integrations/oauth/gemini_oauth/callback to that client.
# ---------------------------------------------------------------------------
VERTEX_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Private workspace sign-in
# "email:password|Display Name" entries, comma separated.
# ---------------------------------------------------------------------------
HAKISCRIBE_USERS=
# Keeps issued sign-ins valid across restarts. Any long random string.
AUTH_SECRET=
# Temporary demo account for judging. Set to false to remove it.
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=demo@hakiscribe.app
DEMO_PASSWORD=hakiscribe-demo
DEMO_NAME=Demo Advocate
